# Copy this file to .env, then replace all development values before deploying.
MYSQL_DATABASE=flowstudio
MYSQL_USER=flowstudio
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
APP_JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
APP_JWT_EXPIRATION_MS=86400000
FRONTEND_PORT=5173
BACKEND_PORT=8080
